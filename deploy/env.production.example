# Copy to .env.production on the server and fill in. Never commit the real file.
# Compose also reads DOMAIN and APP_URL from the same file when you run
# `docker compose --env-file .env.production ...` (see docs/DEPLOY.md).
DOMAIN=puebloconnect.net
APP_URL=https://puebloconnect.net
SESSION_SECRET=
EMAIL_FROM_ADDRESS=no-reply@puebloconnect.net
RESEND_API_KEY=
# Stripe: leave blank until you're ready; use sk_test_ first, then sk_live_.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_ACCOUNT_ID=
# Optional: IP2LOCATION_API_KEY=
