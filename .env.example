# Copy this file to .env.local and fill in real values before running the
# app. .env.local is gitignored — never commit real secrets.

# Long, random string used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing this value invalidates every existing logged-in session.
SESSION_SECRET=

# --- Stripe (business membership checkout) ---
#
# Unlike some processors, Stripe doesn't use a separate sandbox URL — one
# API (api.stripe.com) serves both modes, and test vs. live is decided
# entirely by which Secret Key you set below (sk_test_... vs sk_live_...).
# Flip this one value (and use a live key + live webhook secret) to go
# live — no code change. See src/lib/stripe.ts.
#
# Get these from the Stripe Dashboard (https://dashboard.stripe.com/apikeys)
# for whichever Stripe account should receive the money — log into THAT
# account's dashboard, not a sample/default one. Start with the keys shown
# while "Test mode" is on (top right of the dashboard) and run the whole
# checkout flow with Stripe's test cards (e.g. 4242 4242 4242 4242) before
# switching to live keys — see README.md.
#
# STRIPE_SECRET_KEY must NEVER be sent to the browser or committed
# anywhere — it only lives here, read server-side, in src/lib/stripe.ts.
STRIPE_SECRET_KEY=

# From the Stripe Dashboard → Developers → Webhooks, after adding an
# endpoint pointing at POST /api/stripe/webhook on your deployed URL (for
# local testing, the Stripe CLI's `stripe listen --forward-to
# localhost:3000/api/stripe/webhook` prints a test secret for this). Used
# to verify that a request claiming to be Stripe really came from Stripe —
# see src/lib/stripe.ts's constructWebhookEvent. Also never sent to the
# browser.
STRIPE_WEBHOOK_SECRET=

# Optional, but recommended: the Stripe account ID (looks like
# "acct_xxx...", found at the top of the Stripe Dashboard or under
# Settings → Account details) that STRIPE_SECRET_KEY is expected to belong
# to. If set, every checkout attempt double-checks the key actually
# belongs to this account before charging anyone, and refuses if it
# doesn't — a safety net against an accidental wrong-account key. This
# value is not a secret on its own (it doesn't authenticate anything by
# itself) but still isn't needed by the browser, so it stays server-side.
STRIPE_ACCOUNT_ID=

# --- Membership / email system ---
#
# The base URL this app is actually reachable at, used to build absolute
# links inside emails (verification, password reset). Must match wherever
# this is deployed — e.g. https://app.puebloconnect.com. Defaults to
# http://localhost:3000 if unset (fine for local dev only).
APP_URL=http://localhost:3000

# Resend (https://resend.com) API key for sending real transactional email
# (verification, password reset, security notifications) — see
# src/lib/email.ts. Get this from the Resend dashboard after verifying a
# sending domain (SPF/DKIM/DMARC — see README). Never sent to the browser,
# never hardcoded anywhere in this codebase.
#
# If this is left blank, the app does NOT silently pretend to send email:
# every email is instead written to data/outbox/*.json and logged to the
# console, so registration/login/password-reset can still be fully tested
# without a real provider configured. See src/lib/email.ts.
RESEND_API_KEY=

# The "from" address real email is sent as, e.g.
# no-reply@puebloconnect.com. MUST be on a domain you've verified with
# Resend (or whichever provider RESEND_API_KEY belongs to) — an
# unverified sending domain will have its mail rejected or spam-foldered.
EMAIL_FROM_ADDRESS=no-reply@pueblo-connect.example

# Address of the MVP Lounge 3D City page embedded at /admin/mvp-city (optional)
# MVP_CITY_URL=https://passportstolove.com/city
