# Copy this file to .env.local and fill in real values before running the
# app. .env.local is gitignored — never commit real secrets.

# Long, random string used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing this value invalidates every existing logged-in session.
SESSION_SECRET=

# --- PayPal (business membership checkout) ---
#
# "sandbox" (default if unset) or "production". This ALONE decides which
# PayPal REST API base URL the server calls and which SDK script domain
# the browser loads — see src/lib/paypal.ts and
# src/components/membership/MembershipPlans.tsx. No code change needed to
# go live, just flip this (and use live credentials below).
PAYPAL_ENV=sandbox

# From the PayPal Developer Dashboard (https://developer.paypal.com/dashboard/applications) —
# log into the dashboard for whichever PayPal Business account should
# receive the money, create an app there, and paste its credentials below.
# This file (and the rest of the codebase) never stores or references
# that account's email address — only the app credentials it generates.
#
# Use the app's SANDBOX Client ID/Secret first and test the whole flow in
# PayPal Sandbox (fake buyer + business sandbox accounts, no real money).
# Only switch PAYPAL_ENV to "production" and swap these for the app's LIVE
# Client ID/Secret once that testing is done — see README.md.
#
# PAYPAL_CLIENT_ID is sent to the browser (by design — the PayPal SDK
# requires it client-side; it identifies the app, it is not a secret).
# PAYPAL_CLIENT_SECRET must NEVER be sent to the browser or committed
# anywhere — it only lives here, read server-side, in src/lib/paypal.ts.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
